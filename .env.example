# ---------------------------------------------------------------------------
# Loop — environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon / Supabase / local).
# Neon example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/loop?sslmode=require
# Supabase example: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/loop?schema=public"

# Auth.js (NextAuth v5) — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Base URL of the app (used for callbacks). In dev this is fine as-is.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth app — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# LLM (Anthropic). Without a key, the AI features gracefully fall back to a
# deterministic local heuristic so the app stays fully functional.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
